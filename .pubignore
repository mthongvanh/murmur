# A .pubignore replaces .gitignore for publishing, so this repeats its rules.
.dart_tool/
.packages
build/
**/build/
**/.dart_tool/
**/.flutter-plugins*
**/pubspec.lock
example/android/
example/ios/
example/macos/
example/windows/
example/linux/
example/web/
example/.metadata
.DS_Store

# The README links the gallery GIFs from GitHub, so only the pub.dev
# screenshots ship with the package.
doc/gifs/*
!doc/gifs/aurora_orb.gif
!doc/gifs/spectrum_halo.gif
!doc/gifs/loading_contour_bloom.gif
